{
{
["role"] = "DAMAGER",
["name"] = "Arms",
["className"] = false,
["id"] = 71,
["classFile"] = true,
["icon"] = 132355,
["description"] = "A battle-hardened master of weapons, using mobility and overpowering attacks to strike their opponents down.\r\n\r\nPreferred Weapon: Two-Handed Axe, Mace, Sword",
},
{
["role"] = "DAMAGER",
["name"] = "Fury",
["className"] = false,
["id"] = 72,
["classFile"] = false,
["icon"] = 132347,
["description"] = "A furious dual-wielding berserker unleashing a flurry of attacks to carve their opponents to pieces.\r\n\r\nPreferred Weapons: Dual Two-Handed Axes, Maces, Swords",
},
{
["role"] = "TANK",
["name"] = "Protection",
["className"] = false,
["id"] = 73,
["classFile"] = false,
["icon"] = 132341,
["description"] = "A stalwart protector who uses a shield to safeguard themselves and their allies.\r\n\r\nPreferred Weapon: Axe, Mace, Sword, and Shield",
},
},
{
{
["role"] = "HEALER",
["name"] = "Holy",
["className"] = false,
["id"] = 65,
["classFile"] = false,
["icon"] = 135920,
["description"] = "Invokes the power of the Light to heal and protect allies and vanquish evil from the darkest corners of the world.\r\n\r\nPreferred Weapon: Sword, Mace, and Shield",
},
{
["role"] = "TANK",
["name"] = "Protection",
["className"] = false,
["id"] = 66,
["classFile"] = false,
["icon"] = 236264,
["description"] = "Uses Holy magic to shield themselves and defend allies from attackers.\r\n\r\nPreferred Weapon: Sword, Mace, Axe, and Shield",
},
{
["role"] = "DAMAGER",
["name"] = "Retribution",
["className"] = false,
["id"] = 70,
["classFile"] = true,
["icon"] = 135873,
["description"] = "A righteous crusader who judges and punishes opponents with weapons and Holy magic.\r\n\r\nPreferred Weapon: Two-Handed Sword, Mace, Axe",
},
},
{
{
