["spellDescriptionCache"] = {
[1220618] = {
["time"] = 1772840534,
["description"] = "The Plexus Sentinel relocates, pushing players away and activating the |cffffffffArcanomatrix Atomizer|r. The Atomizer slowly passes over the chamber, Atomizing any players  it contacts.\r\n\r\nAfter relocating, The Plexus Sentinel begins channelling |cffffffffProtocol: Purge|r and gains a shield that absorbs damage. Breaking this shield interrupts |cffffffffProtocol: Purge|r.",
},
[1262289] = {
["time"] = 1773337262,
["description"] = "Chimaerus tears a hole in Reality, inflicting 388,249 Physical damage to its current target and 621,197 Nature damage split evenly between players within 10 yards of the impact.\r\n\r\nVictims are knocked into the air and gain |cffffffffAlnsight|r.",
},
[1219450] = {
["time"] = 1772840534,
["description"] = "The Plexus Sentinel fires Arcane energy into players, inflicting 26,520 Arcane damage every 1 sec for 6 sec. Upon expiration, a |cffffffffDisplacement Matrix|r is created. ",
},
[1257087] = {
["time"] = 1773337262,
["description"] = "Chimaerus surrounds several players with ravenous energy, causing them to suffer $s1 Nature damage every $t1 sec for $d.\r\n\r\nUpon removal, the target erupts with $@spellname1257093 and consumes $@spellname1245857 within $1257093A1 yards.",
},
[133] = {
["time"] = 1773447088,
["description"] = "Throws a fiery ball that causes 6,425 Fire damage.",
},
[1245404] = {
["time"] = 1773337262,
["description"] = "Chimaerus descends to the ground, inflicting 77,649 Physical damage to all players upon landing and knocking them into the air.\r\n\r\nAny remaining Manifestations are consumed, causing Chimaerus to cast |cffffffffCannibalized Essence|r for each Manifestation consumed.",
},
[1219531] = {
["time"] = 1772840534,
["description"] = "The Plexus Sentinel targets a player to be purged, firing a missile inflicting 454,642 Arcane damage split evenly between players within 6 yards.",
},
[1264756] = {
["time"] = 1773337262,
["description"] = "Chimaerus causes several players within the Rift to succumb to madness, inflicting 51,766 Nature damage to players within 6 yards and horrifying them, causing them to suffer 12,941 Nature damage every 1 sec. This effect increases in intensity every 3 sec.\r\n\r\nAllies outside the Rift can stand nearby the victims to swap realms with them after a short duration, saving them from the madness.",
},
[1245452] = {
["time"] = 1773337262,
["description"] = "Chimaerus sweeps across its den, exhaling corruption that inflicts 258,832 Nature damage to players standing in the area and stuns them for 1 sec.\r\n\r\nThe spewed corruption coalesces Manifestations and leaves behind |cffffffffAlndust Essence|r.",
},
[1246653] = {
["time"] = 1773337262,
["description"] = "Chimaerus launches globs of phlegm at all players, inflicting 31,059 Nature damage every 1 sec for 20 sec.",
},
[1245396] = {
["time"] = 1773337262,
["description"] = "Chimaerus consumes the essence of its enemies, inflicting 103,533 Nature damage every 2 sec for 10 sec.\r\n\r\nUpon finishing its channel, Chimaerus knocks players away and consumes any remaining Manifestations, casting |cffffffffCannibalized Essence|r for each Manifestation consumed.",
},
[1258610] = {
["time"] = 1773337262,
["description"] = "Chimaerus unleashes an unearthly roar, inflicting 142,358 Nature damage to all players and causing Manifestations to emerge throughout the Rift.",
},
[1272726] = {
["time"] = 1773337262,
["description"] = "Chimaerus slashes in the direction of a nearby target, inflicting 77,649 Physical damage to players in a frontal cone, causing them to bleed for 25,883 Physical damage every 1.5 sec for 6 sec and knocking them away.",
},
[1246132] = {
["time"] = 1773337262,
["description"] = "Chimaerus is protected by the shroud of its den while in the air, reducing damage taken by 99%.",
},
[1219263] = {
["time"] = 1772840534,
["description"] = "The Plexus Sentinel marks its current target, then fires an arcane charge that inflicts 284,151 Arcane damage to players within 10 yards, and 189,434 Arcane damage to all other players. Players farther from the target receive less damage. This explosion leaves behind |cffffffffPotent Mana Residue|r.\r\n\r\nThe impact causes the primary target to take 1,000% damage from |cffffffffObliteration Arcanocannon|r for 45 sec.",
},
},
},
