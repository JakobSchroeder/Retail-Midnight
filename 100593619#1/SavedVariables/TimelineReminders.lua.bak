["spellDescriptionCache"] = {
[1246132] = {
["time"] = 1777277397,
["description"] = "Chimaerus is protected by the shroud of its den while in the air, reducing damage taken by 99%.",
},
[1282043] = {
["time"] = 1777298926,
["description"] = "L'ura exerts her cosmic grip upon all players, pulling them into the heart of the Darkwell.",
},
[1285510] = {
["time"] = 1777298926,
["description"] = "L'ura coalesces glass spikes that descend upon random players, inflicting 104,213 Cosmic damage.\r\n\r\nFractured shards erupt outward from each target, inflicting 446,627 Cosmic damage to any players hit.",
},
[1258610] = {
["time"] = 1777277397,
["description"] = "Chimaerus unleashes an unearthly roar, inflicting 136,470 Nature damage to all players and causing Manifestations to emerge throughout the Rift.",
},
[1272726] = {
["time"] = 1777277397,
["description"] = "Chimaerus slashes in the direction of a nearby target, inflicting 74,438 Physical damage to players in a frontal cone, causing them to bleed for 24,813 Physical damage every 1.5 sec for 6 sec and knocking them away.",
},
[1249609] = {
["time"] = 1777298926,
["description"] = "Marked with a musical note, inflicting 11,166 Cosmic damage every 1 sec. \r\n\r\nUpon activation, triggers either |cffffffffResonance|r or |cffffffffDissonance|r.",
},
[1245452] = {
["time"] = 1777277397,
["description"] = "Chimaerus sweeps across its den, exhaling corruption that inflicts 248,126 Nature damage to players standing in the area and stuns them for 1 sec.\r\n\r\nThe spewed corruption coalesces Manifestations and leaves behind |cffffffffAlndust Essence|r.",
},
[1246653] = {
["time"] = 1777277397,
["description"] = "Chimaerus launches globs of phlegm at all players, inflicting 29,775 Nature damage every 1 sec for 20 sec.",
},
[1245396] = {
["time"] = 1777277397,
["description"] = "Chimaerus consumes the essence of its enemies, inflicting 99,251 Nature damage every 2 sec for 10 sec.\r\n\r\nUpon finishing its channel, Chimaerus knocks players away and consumes any remaining Manifestations, casting |cffffffffCannibalized Essence|r for each Manifestation consumed.",
},
[1279420] = {
["time"] = 1777298926,
["description"] = "|cffffffffThe Darkwell|r releases jets of excess void energy, inflicting 136,470 Cosmic damage every 0.3 sec to players within them.",
},
[1284525] = {
["time"] = 1777298926,
["description"] = "L'ura fires electric beams at random players, each inflicting 111,657 Cosmic damage to all players hit.\r\n\r\nImpact with a |cffffffffVoid Core|r triggers |cffffffffCosmic Fission|r.\r\n",
},
[1276525] = {
["time"] = 1777298926,
["description"] = "Armageddon upon you.",
},
[1245404] = {
["time"] = 1777277397,
["description"] = "Chimaerus descends to the ground, inflicting 74,438 Physical damage to all players upon landing and knocking them into the air.\r\n\r\nAny remaining Manifestations are consumed, causing Chimaerus to cast |cffffffffCannibalized Essence|r for each Manifestation consumed.",
},
[1262289] = {
["time"] = 1777277397,
["description"] = "Chimaerus tears a hole in Reality, inflicting 372,190 Physical damage to its current target and 595,503 Nature damage split evenly between players within 10 yards of the impact.\r\n\r\nVictims are knocked into the air and gain |cffffffffAlnsight|r.",
},
[1219450] = {
["time"] = 1772836998,
["description"] = "The Plexus Sentinel fires Arcane energy into players, inflicting 7,666 Arcane damage every 1 sec for 6 sec. Upon expiration, a |cffffffffDisplacement Matrix|r is created. ",
},
[1219263] = {
["time"] = 1772836998,
["description"] = "The Plexus Sentinel marks its current target, then fires an arcane charge that inflicts 82,131 Arcane damage to players within 10 yards, and 54,754 Arcane damage to all other players. Players farther from the target receive less damage. This explosion leaves behind |cffffffffPotent Mana Residue|r.\r\n\r\nThe impact causes the primary target to take 1,000% damage from |cffffffffObliteration Arcanocannon|r for 45 sec.",
},
[1266388] = {
["time"] = 1777298926,
["description"] = "L'ura calls down dark stars, inflicting 620,316 Cosmic damage within 2 yards of each impact. \r\n\r\nThe stars interconnect, inflicting 62,032 Cosmic damage to players within the patterns.",
},
[1253915] = {
["time"] = 1777298926,
["description"] = "L'ura spins and unleashes whirling blades that eviscerate players on contact, inflicting up to 248,125 Cosmic damage. \r\n\r\nThe blades ricochet through the chamber, inflicting reduced damage as they lose speed.",
},
[198589] = {
["time"] = 1777298975,
["description"] = "Reduces all damage taken by 25% for 10 sec.",
},
[1266897] = {
["time"] = 1777298926,
["description"] = "L'ura invokes voracious rifts that hunger for light, inflicting 4,963 Cosmic damage to players within 6 yards every 0.5 for up to 22 sec.\r\n\r\nRifts that expire before they are satiated detonate in a |cffffffffStellar Implosion|r.",
},
[1264756] = {
["time"] = 1777277397,
["description"] = "Chimaerus causes several players within the Rift to succumb to madness, inflicting 49,625 Nature damage to players within 6 yards and horrifying them, causing them to suffer 12,406 Nature damage every 1 sec. This effect increases in intensity every 3 sec.\r\n\r\nAllies outside the Rift can stand nearby the victims to swap realms with them after a short duration, saving them from the madness.",
},
[1251343] = {
["time"] = 1777298926,
["description"] = "L'ura transfigures into an unholy weapon of godlike destruction, firing a cataclysmic blast that inflicts 17.3 million Cosmic damage to all players.",
},
[1267049] = {
["time"] = 1777298926,
["description"] = "L'ura regenerates a halo of glass ornaments over time. Upon reaching 5 applications, she forges the glass into spikes that fire into her current target.\r\n\r\nEach impact inflicts 74,438 Cosmic damage and applies |cffffffffImpaled|r.",
},
[1263253] = {
["time"] = 1777298926,
["description"] = "The aftershocks trigger a wave of void to cascade from the Darkwell, inflicting 595,503 Cosmic damage and an additional 59,550 Cosmic damage every 1 sec to players caught within.",
},
[1281184] = {
["time"] = 1777298926,
["description"] = "A chain reaction inflicts 148,876 Cosmic damage within 5 yards of all players.",
},
[1287447] = {
["time"] = 1777298926,
["description"] = "Midnight perpetual.",
},
[1275057] = {
["time"] = 1777298926,
["description"] = "L'ura transcends, diverging both players and her own being across two alternate dimensions. The violent division inflicts 136,470 Cosmic damage to all players.",
},
[1285708] = {
["time"] = 1777298926,
["description"] = "It's time to face the music.",
},
[1285563] = {
["time"] = 1777298926,
["description"] = "L'ura transfigures into a conduit within the Darkwell, regenerating her energy and applying |cffffffffEclipsed|r to all players every 1 sec for 30 sec.",
},
[1284931] = {
["time"] = 1777298926,
["description"] = "L'ura synthesizes a revolving assault of Termination Matrices, each increasing her damage done by 33% for up to 20 sec.",
},
[1282412] = {
["time"] = 1777298926,
["description"] = "L'ura pulls each |cffffffffCharged Core|r into herself for absorption, inflicting 29,775 Cosmic damage to all players and regenerating her energy.",
},
[1257087] = {
["time"] = 1777277397,
["description"] = "Chimaerus surrounds several players with ravenous energy, causing them to suffer 41,685 Nature damage every 1.5 sec for 1 min.\r\n\r\nUpon removal, the target erupts with |cffffffffLingering Miasma|r and consumes |cffffffffAlndust Essence|r within 10 yards.",
},
[1281123] = {
["time"] = 1777298926,
["description"] = "Upon reaching 100 energy, L'ura activates the Darkwell's full potential, expelling all players with an astronomic blast inflicting 148,876 Cosmic damage.\r\n",
},
[1219531] = {
["time"] = 1772836998,
["description"] = "The Plexus Sentinel targets a player to be purged, firing a missile inflicting 131,410 Arcane damage split evenly between players within 6 yards.",
},
[1220618] = {
["time"] = 1772836998,
["description"] = "The Plexus Sentinel relocates, pushing players away and activating the |cffffffffArcanomatrix Atomizer|r. The Atomizer slowly passes over the chamber, Atomizing any players  it contacts.\r\n\r\nAfter relocating, The Plexus Sentinel begins channelling |cffffffffProtocol: Purge|r and gains a shield that absorbs damage. Breaking this shield interrupts |cffffffffProtocol: Purge|r.",
},
[133] = {
["time"] = 1777277397,
["description"] = "Throws a fiery ball that causes 9,614 Fire damage.",
},
[1260088] = {
["time"] = 1777277397,
["description"] = "Increases the caster's attack speed and movement speed by 100% and all damage it inflicts by 500%. Also grants immunity to Taunt effects.",
},
},
},
