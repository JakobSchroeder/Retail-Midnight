["id"] = 270,
["classFile"] = false,
["icon"] = 608952,
["description"] = "A healer who masters the mysterious art of manipulating life energies aided by the wisdom of the Jade Serpent.\r\n\r\nPreferred Weapon: Staff, Mace, Sword",
},
{
["role"] = "DAMAGER",
