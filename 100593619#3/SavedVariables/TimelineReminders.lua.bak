["id"] = 102,
["classFile"] = true,
["icon"] = 136096,
["description"] = "Can shapeshift into a powerful Moonkin, balancing the power of Arcane and Nature magic to destroy enemies.\r\n\r\nPreferred Weapon: Staff, Dagger, Mace",
