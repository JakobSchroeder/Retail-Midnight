1,
},
["glow_border"] = true,
["do_sound"] = true,
["glow_type"] = "Pixel",
["use_glow_color"] = true,
["sound"] = "Interface\\Addons\\NorthernSkyRaidTools\\Media\\Sounds\\Dispel.ogg",
