},
["subeventPrefix"] = "SPELL",
["check"] = "event",
["custom_type"] = "stateupdate",
["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then        \n        local state = {\n            show = true,\n            progressType = \"timed\",\n            duration = 15,\n            expirationTime = 15+GetTime(),\n            autoHide = true,\n        }\n        s:Update(\"\", state)\n    elseif e == \"NS_SELF_DWARF\" then\n        local now = GetTime()\n        if (not aura_env.startTime) or now > aura_env.startTime+120 then\n            local state = {\n                show = true,\n                progressType = \"timed\",\n                duration = 15,\n                expirationTime = 15+GetTime(),\n                autoHide = true,\n            }\n            s:Update(\"\", state)\n            if NSAPI then NSAPI:TTS(\"Use Dwarf\") end\n        end\n    elseif e == \"ENCOUNTER_START\" then\n        aura_env.startTime = 0\n    elseif e == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local u, cast, spellID = ... -- Unit event\n        if spellID == 20594 or spellID == 265221 then\n            aura_env.startTime = GetTime()\n            s:RemoveAll()\n        end\n    end\nend\n\n\n\n\n\n",
["debuffType"] = "HELPFUL",
},
